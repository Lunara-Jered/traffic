generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum Plan {
  FREE
  STANDARD
  PREMIUM
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AssetStatus {
  PROCESSING
  READY
  FAILED
}

enum ReportStatus {
  RECEIVED
  REVIEWING
  RESOLVED
  REJECTED
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  role           UserRole       @default(USER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  profiles       Profile[]
  subscription   Subscription?
  refreshTokens  RefreshToken[]
  payments       Payment[]
}

model Profile {
  id             String         @id @default(cuid())
  userId         String
  name           String
  isKids         Boolean        @default(false)
  language       String         @default("fr")
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchHistory   WatchHistory[]
  watchlist      Watchlist[]
  ratings        Rating[]

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                  String   @id @default(cuid())
  userId              String
  providerReference   String   @unique
  amountCents         Int
  currency            String
  status              String
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Movie {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  synopsis       String        @db.Text
  releaseYear    Int
  imdbRating     Float?
  durationMinutes Int?
  posterUrl      String?
  videoAssetId   String?       @unique
  createdAt      DateTime      @default(now())
  genres         MovieGenre[]
  cast           MovieCast[]
  videoAsset     VideoAsset?   @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)
  watchHistory   WatchHistory[]
  watchlist      Watchlist[]
  ratings        Rating[]
}

model Series {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  synopsis     String        @db.Text
  releaseYear  Int
  posterUrl    String?
  createdAt    DateTime      @default(now())
  seasons      Season[]
  genres       SeriesGenre[]
  cast         SeriesCast[]
  watchlist    Watchlist[]
  ratings      Rating[]
}

model Season {
  id        String    @id @default(cuid())
  seriesId  String
  number    Int
  title     String?
  series    Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes  Episode[]

  @@unique([seriesId, number])
}

model Episode {
  id             String        @id @default(cuid())
  seasonId       String
  number         Int
  title          String
  synopsis       String        @db.Text
  durationMinutes Int?
  videoAssetId   String?       @unique
  season         Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  videoAsset     VideoAsset?   @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)
  watchHistory   WatchHistory[]

  @@unique([seasonId, number])
}

model Genre {
  id      String        @id @default(cuid())
  name    String        @unique
  movies  MovieGenre[]
  series  SeriesGenre[]
}

model MovieGenre {
  movieId String
  genreId String
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
}

model SeriesGenre {
  seriesId String
  genreId  String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([seriesId, genreId])
}

model Cast {
  id        String      @id @default(cuid())
  name      String
  biography String?     @db.Text
  photoUrl  String?
  movies    MovieCast[]
  series    SeriesCast[]
}

model MovieCast {
  movieId String
  castId  String
  role    String?
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  cast    Cast   @relation(fields: [castId], references: [id], onDelete: Cascade)

  @@id([movieId, castId])
}

model SeriesCast {
  seriesId String
  castId   String
  role     String?
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  cast     Cast   @relation(fields: [castId], references: [id], onDelete: Cascade)

  @@id([seriesId, castId])
}

model WatchHistory {
  id              String    @id @default(cuid())
  profileId       String
  movieId         String?
  episodeId       String?
  progressSeconds Int       @default(0)
  completed       Boolean   @default(false)
  updatedAt       DateTime  @updatedAt
  profile         Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movie           Movie?    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode         Episode?  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([profileId, updatedAt])
}

model Watchlist {
  id        String   @id @default(cuid())
  profileId String
  movieId   String?
  seriesId  String?
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([profileId, movieId])
  @@unique([profileId, seriesId])
  @@index([profileId, createdAt])
}

model Rating {
  id        String   @id @default(cuid())
  profileId String
  movieId   String?
  seriesId  String?
  score     Int
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([profileId, movieId])
  @@unique([profileId, seriesId])
}

model LiveChannel {
  id         String       @id @default(cuid())
  name       String
  category   String
  streamKey  String
  logoUrl    String?
  isActive   Boolean      @default(true)
  programs   EPGProgram[]
}

model EPGProgram {
  id          String      @id @default(cuid())
  channelId   String
  title       String
  description String?     @db.Text
  startsAt    DateTime
  endsAt      DateTime
  channel     LiveChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, startsAt])
}

model VideoAsset {
  id          String      @id @default(cuid())
  storageKey  String      @unique
  status      AssetStatus @default(PROCESSING)
  minimumPlan Plan        @default(FREE)
  duration    Int?
  resolutions String[]
  subtitles   String[]
  createdAt   DateTime    @default(now())
  movie       Movie?
  episode     Episode?
}

model RightsReport {
  id                String       @id @default(cuid())
  contactEmail      String
  rightsHolderName  String
  contentUrl        String
  details           String       @db.Text
  status            ReportStatus @default(RECEIVED)
  createdAt         DateTime     @default(now())

  @@index([status, createdAt])
}